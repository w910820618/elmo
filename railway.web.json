{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @workspace/web build"
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @workspace/lib exec drizzle-kit migrate"],
    "startCommand": "node apps/web/.output/server/index.mjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
